{
  "info": {
    "name": "SmartShopLab API — Demo FAIL (lab)",
    "description": "Copia de la colección completa con un assert intencional incorrecto en Get Products (count === 999). Solo para demostrar un fallo de Newman. La suite verde es smartshoplab.postman_collection.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Service name', () => pm.expect(pm.response.json().service).to.eql('SmartShopLab API'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Products (LAB: assert incorrecto)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has products (LAB FAIL: espera count 999)', () => pm.expect(pm.response.json().count).to.eql(999));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/prod-laptop-001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Product name', () => pm.expect(pm.response.json().product.name).to.include('Laptop'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Cart",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/cart"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Cart has items', () => pm.expect(pm.response.json().cart.items.length).to.be.above(0));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Add to Cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"productId\": \"prod-keyboard-003\", \"quantity\": 1}"
        },
        "url": "{{baseUrl}}/api/cart/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "AI Chat",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"¿Cuánto cuesta la laptop?\"}"
        },
        "url": "{{baseUrl}}/api/ai/chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has reply', () => pm.expect(pm.response.json().reply).to.be.a('string'));",
              "pm.test('Not hallucination', () => pm.expect(pm.response.json().isHallucination).to.eql(false));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "AI Chat Hallucination",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"¿Tienen garantía de por vida?\"}"
        },
        "url": "{{baseUrl}}/api/ai/chat"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Is hallucination', () => pm.expect(pm.response.json().isHallucination).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
