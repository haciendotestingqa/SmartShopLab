# Copia este archivo a .env:
#   cp mobile-app/.env.example mobile-app/.env
#
# .env está en .gitignore (no se versiona).
# Activa UNA sola URL según el entorno (comenta las otras).

# --- Hosted (API en Render; misma que usa la web de Vercel) ---
# EXPO_PUBLIC_API_URL=https://smartshoplab.onrender.com

# --- Local: Android emulator → host del PC ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# --- Local: iOS simulator → localhost del Mac ---
# EXPO_PUBLIC_API_URL=http://localhost:3001

# --- Dispositivo físico → IP LAN de tu Mac (ej. http://192.168.1.10:3001) ---
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

EXPO_PUBLIC_AI_PROVIDER=openrouter
