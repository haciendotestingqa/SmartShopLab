# Copy this file to .env.ai-evals and add your API key:
#   cp .env.ai-evals.example .env.ai-evals
#
# Get a key at: https://openrouter.ai/keys
# .env.ai-evals is gitignored (not versioned)

OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY

# Free Gemma models often hit HTTP 429. Recommended :free alternatives:
#   nvidia/nemotron-3.5-lightning:free
#   liquid/lfm-2.5-2.6b:free
#   thinkingmachines/inkling-small:free
#   z-ai/glm-5.2:free
#   google/gemma-4-26b-a4b-it:free
#   google/gemma-4-31b-it:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Judge model for `npm run test:mobile:ai` (LLM-as-judge). Can match assistant or differ.
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,thinkingmachines/inkling-small:free,z-ai/glm-5.2:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SmartShopLab-AI-Evals