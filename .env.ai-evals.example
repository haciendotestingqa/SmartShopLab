# Copia este archivo a .env.ai-evals y completa tu API key:
#   cp .env.ai-evals.example .env.ai-evals
#
# Obtén la key en: https://openrouter.ai/keys
# .env.ai-evals está en .gitignore (no se versiona)

OPENROUTER_API_KEY=sk-or-v1-REEMPLAZA_CON_TU_CLAVE

# Gemma free suele saturar (HTTP 429). Alternativas :free recomendadas:
#   nvidia/nemotron-3.5-lightning:free
#   liquid/lfm-2.5-2.6b:free
#   thinkingmachines/inkling-small:free
#   z-ai/glm-5.2:free
#   google/gemma-4-26b-a4b-it:free
#   google/gemma-4-31b-it:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Modelo juez para `npm run test:mobile:ai` (LLM-as-judge). Puede ser el mismo u otro.
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,thinkingmachines/inkling-small:free,z-ai/glm-5.2:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SmartShopLab-AI-Evals
