# Copia este archivo a .env.maestro.local si necesitas overrides locales:
#   cp .env.maestro.local.example .env.maestro.local
#
# .env.maestro.local está en .gitignore (no se versiona).

# Plataforma: android | ios
# Por defecto: android (device emulator-5554 + adb reverse)
# MAESTRO_PLATFORM=android
# MAESTRO_DEVICE=emulator-5554

# iOS simulator (Expo Go). UDID opcional: si falta, se usa el simulador booted.
# MAESTRO_PLATFORM=ios
# MAESTRO_DEVICE=5F21FDB7-9CE9-4729-9728-71C6680DB9B4
# appId Expo Go (solo si hace falta override; por defecto ya va correcto por plataforma)
# MAESTRO_APP_ID=host.exp.Exponent
# Deep link Metro (usa siempre la misma URL para no duplicar Recently opened)
# MAESTRO_EXPO_URL=exp://127.0.0.1:8081

# Si el puerto del driver (7001) está ocupado, elige uno libre.
# Requiere un Maestro CLI con soporte --driver-host-port.
# MAESTRO_DRIVER_HOST_PORT=7005
