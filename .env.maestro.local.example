# Copy to .env.maestro.local if you need local overrides:
#   cp .env.maestro.local.example .env.maestro.local
#
# .env.maestro.local is gitignored (not versioned).

# Platform: android | ios
# Default: android (device emulator-5554 + adb reverse)
# MAESTRO_PLATFORM=android
# MAESTRO_DEVICE=emulator-5554

# iOS simulator (Expo Go). UDID optional: if missing, uses booted simulator.
# MAESTRO_PLATFORM=ios
# MAESTRO_DEVICE=5F21FDB7-9CE9-4729-9728-71C6680DB9B4
# Expo Go appId (override only if needed; default is correct per platform)
# MAESTRO_APP_ID=host.exp.Exponent
# Metro deep link (use the same URL to avoid duplicate Recently opened entries)
# MAESTRO_EXPO_URL=exp://127.0.0.1:8081

# If driver port (7001) is busy, pick a free one.
# Requires Maestro CLI with --driver-host-port support.
# MAESTRO_DRIVER_HOST_PORT=7005